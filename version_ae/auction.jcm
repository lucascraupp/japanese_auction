mas sma {

    agent auctioneer : auctioneer.asl

    agent alice : bidder.asl {
        beliefs: max_price(70)
    }
    agent bob : bidder.asl {
        beliefs: max_price(85)
    }
    agent carol : bidder.asl {
        beliefs: max_price(95)
    }

    workspace w {
        artifact auction_house: auction.AuctionHouse("how_to_get_a_top_grade_in_SMA.pdf", 50, 5)
    }
}
